# MelaNone backend configuration. Copy to `.env` and adjust for your machine.
# All values are optional — sensible defaults live in backend/app/config.py.

# --- Demo mode ---
# When true, hardware + ML are mocked with clearly-labeled synthetic data so the app
# runs with no rig attached. MUST stay false for real scans.
DEMO_MODE=false

# --- API ---
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Hardware / serial ---
# Leave SERIAL_PORT unset to auto-detect. Windows example: COM6  Linux: /dev/ttyUSB0
# SERIAL_PORT=
# SERIAL_BAUD=115200
# SERIAL_TIMEOUT_S=5.0

# --- Capture ---
# CAMERA_INDICES=1,2
# ROTATION_STEPS=4
# ANGLE_STEP_DEG=90

# --- Storage (defaults to repo-local artifacts/ and data/melanone.db) ---
# ARTIFACT_ROOT=
# DB_URL=sqlite:///./data/melanone.db
